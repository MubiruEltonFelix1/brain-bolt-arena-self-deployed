{
  "name": "@brainbolt/mcp",
  "private": true,
  "version": "0.3.0",
  "description": "MCP server that connects Brain Bolt Arena to any LLM (OpenAI-compatible) to generate quizzes in the app's native format.",
  "type": "module",
  "bin": {
    "brainbolt-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test && bun tsc --noEmit -p tsconfig.json",
    "smoke": "bun run scripts/smoke.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.108.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.16.5",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
  }
}

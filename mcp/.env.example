# Copy this file to mcp/.env and fill in the values. mcp/.env is git-ignored.

# --- LLM connection (OpenAI-compatible chat completions endpoint) ---
# Any provider with a /chat/completions API works:
#   OpenAI      https://api.openai.com/v1
#   Anthropic   https://api.anthropic.com/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (no key needed)
#   LM Studio   http://localhost:1234/v1    (no key needed)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Optional: save_quiz tool (writes generated quizzes into Supabase) ---
# Leave unset to keep save_quiz disabled (JSON/CSV output still works).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Auth user id (uuid) that generated quizzes are attributed to. Must be a real
# user in auth.users — the DB trigger derives owner_principal_id from it.
BRAINBOLT_DEFAULT_OWNER_ID=
